<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisplaySwap" Width="1060" Height="780" MinWidth="860" MinHeight="640"
        Background="#111318" Foreground="#E8EAF0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#181B21"/>
    <SolidColorBrush x:Key="Card" Color="#1F232B"/>
    <SolidColorBrush x:Key="CardHover" Color="#262B35"/>
    <SolidColorBrush x:Key="Line" Color="#2C313B"/>
    <SolidColorBrush x:Key="Sub" Color="#949BA8"/>
    <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="Hdr" Color="#F5B942"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="Background" Value="#262B35"/>
      <Setter Property="BorderBrush" Value="#343A46"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#5B8CFF"/>
      <Setter Property="BorderBrush" Value="#5B8CFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="CaretBrush" Value="#E8EAF0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="SelectionBrush" Value="#5B8CFF"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#343A46"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#5B8CFF"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="#2C313B" VerticalAlignment="Center">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#C9CED8" HorizontalAlignment="Left" Margin="3,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#5B8CFF"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark ComboBox -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
      <Border x:Name="b" Background="#262B35" BorderBrush="#343A46" BorderThickness="1" CornerRadius="7">
        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#949BA8"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#4A5260"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#20242C" BorderBrush="#343A46" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Padding="4">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E8EAF0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="9,6">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2E3440"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#2A3A60"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate><Border Background="#3A404C" CornerRadius="3"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="24,18,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="#5B8CFF">
          <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="19" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="DisplaySwap" FontSize="19" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock x:Name="CurrentText" Text="Reading displays..." Foreground="{StaticResource Sub}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
        </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="RefreshBtn" Style="{StaticResource GhostBtn}" ToolTip="Re-read displays" Margin="0,0,4,0">
          <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="15"/>
        </Button>
        <Button x:Name="SettingsBtn" Style="{StaticResource GhostBtn}" ToolTip="Settings" Margin="0,0,10,0">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15"/>
        </Button>
        <Button x:Name="NewBtn" Style="{StaticResource AccentBtn}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Save current setup"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsBtn}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-230">
        <Border Background="#20242C" BorderBrush="#343A46" BorderThickness="1" CornerRadius="10" Padding="18,14" Width="300" Margin="0,6,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Sub}" FontSize="11.5"/>
            </Grid>
            <CheckBox x:Name="OptStartup" Content="Start with Windows (in tray)"/>
            <CheckBox x:Name="OptTray" Content="Close button hides to tray"/>
            <CheckBox x:Name="OptConfirm" Content="Ask to keep after switching"/>
            <TextBlock Text="If you don't confirm within 15 s, the previous setup comes back (handy if a screen stays black)."
                       TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11.5" Margin="46,0,0,6"/>
            <CheckBox x:Name="OptRefresh" Content="Refresh HDR after switching"/>
            <TextBlock Text="Turns HDR off and on once after a switch that changed something, so Windows surely reloads the colour profile. Adds a short black screen."
                       TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11.5" Margin="46,0,0,6"/>
            <Border Height="1" Background="#343A46" Margin="0,10,0,12"/>
            <TextBlock Text="TV power" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="TvStatus" Text="Not paired" TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="11.5" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button x:Name="TvPairBtn" Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,8,0">
                <TextBlock x:Name="TvPairText" Text="Find &amp; pair TV" FontSize="12"/>
              </Button>
              <Button x:Name="TvCustomBtn" Style="{StaticResource Btn}" Padding="10,5" ToolTip="Your own on/off commands, for any TV">
                <TextBlock Text="Custom commands..." FontSize="12"/>
              </Button>
            </StackPanel>
            <CheckBox x:Name="OptTvOn" Content="Turn the TV on when a profile uses it"/>
            <CheckBox x:Name="OptTvOff" Content="Turn the TV off when switching away"/>
            <Border Height="1" Background="#343A46" Margin="0,8,0,4"/>
            <Button x:Name="OpenFolderBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5">
              <TextBlock Text="Open profiles folder" FontSize="12"/>
            </Button>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="PROFILES" Foreground="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,10"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ProfileList"/>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
          <!-- Empty state -->
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="#3A404C" HorizontalAlignment="Center"/>
            <TextBlock Text="No profiles yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,8"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Sub}" LineHeight="20">
              Set your screens up the way you want in Windows (Win+P, or Settings › Display), with HDR on or off,
              then click <Run Foreground="#E8EAF0" FontWeight="SemiBold">Save current setup</Run>. Repeat for each setup, such as "Desk" and "TV only".
            </TextBlock>
          </StackPanel>

          <!-- Detail -->
          <DockPanel x:Name="Detail" Margin="26,22,26,20">
            <Grid DockPanel.Dock="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBox x:Name="NameBox" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Padding="0,0,0,2" MinWidth="200" HorizontalAlignment="Left"/>
                <TextBlock x:Name="DetailSub" Foreground="{StaticResource Sub}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ShortcutBtn" Style="{StaticResource GhostBtn}" ToolTip="Make a desktop shortcut that switches to this profile" Margin="0,0,2,0">
                  <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" FontSize="15"/>
                </Button>
                <Button x:Name="DeleteBtn" Style="{StaticResource GhostBtn}" ToolTip="Delete profile" Margin="0,0,10,0">
                  <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FF7B7B"/>
                </Button>
                <Button x:Name="ApplyBtn" Style="{StaticResource AccentBtn}" Padding="18,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Switch to this"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Everything below the title scrolls together, so nothing overlaps in a small window. -->
            <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Height="160" CornerRadius="12" Background="#14161B" BorderBrush="{StaticResource Line}" BorderThickness="1">
                  <Canvas x:Name="Preview" ClipToBounds="True"/>
                </Border>
                <TextBlock Text="SCREENS" Foreground="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Margin="2,20,0,10"/>
                <StackPanel x:Name="DisplayRows"/>
                <TextBlock Text="SOUND" Foreground="{StaticResource Sub}" FontSize="11" FontWeight="SemiBold" Margin="2,12,0,10"/>
                <Border Background="#1F232B" CornerRadius="10" Padding="16,10,14,10" Margin="0,0,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Sound output" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock x:Name="SoundSub" Text="Becomes the Windows default when switching" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="SoundBox" Width="360" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  </Grid>
                </Border>
                <Grid Margin="0,16,0,2">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hotkey" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="HotkeyBox" Width="190"/>
                  </StackPanel>
                  <Button x:Name="UpdateBtn" Style="{StaticResource Btn}" HorizontalAlignment="Right"
                          ToolTip="Replace this profile's screens, resolutions and positions with what Windows shows right now">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Overwrite with current setup"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Status -->
    <Border Grid.Row="2" Margin="24,12,24,14">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3DD68C" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Sub}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="820"/>
        </StackPanel>
        <Button x:Name="LogBtn" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Padding="6,2">
          <TextBlock Text="Log" Foreground="{StaticResource Sub}" FontSize="12"/>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
